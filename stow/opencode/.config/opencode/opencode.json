{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.3-codex",
  "permission": {
    "external_directory": {
      "~/.config/opencode/**": "allow",
      "~/.opencode/**": "allow",
      "~/vaults/Brains/**": "allow"
    },
    "read": {
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*": "allow"
    }
  }
}
