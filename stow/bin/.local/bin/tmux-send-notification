#!/bin/bash
# ---
# menu-name: Send Notification
# menu-group: notifications
# ---
# Usage: tmux-send-notification <session> <window> [pane] <message>

SESSION="$1"
WINDOW="$2"
shift 2

if [[ "$1" =~ ^[0-9]+$ ]]; then
  PANE="$1"
  shift
else
  PANE=""
fi

MESSAGE="$*"
LOGFILE="$HOME/.tmux/notifications.log"

if [[ -z "$SESSION" || -z "$WINDOW" || -z "$MESSAGE" ]]; then
  echo "Usage: tmux-send-notification <session> <window> [pane] <message>"
  exit 1
fi

TIMESTAMP=$(date '+%Y-%m-%d %H:%M:%S')
echo "$TIMESTAMP|$SESSION|$WINDOW|$PANE|$MESSAGE" >> "$LOGFILE"

tmux display-message -t "$SESSION:$WINDOW" "Notification: $MESSAGE"

echo "Sent to $SESSION:$WINDOW${PANE:+.$PANE}: $MESSAGE"
