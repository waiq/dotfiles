#!/bin/bash
# Read tmux notifications with fzf in popup, ESC to close, Enter to jump to session:window.pane

LOGFILE="$HOME/.tmux/notifications.log"

if [[ ! -f "$LOGFILE" ]]; then
  tmux display-message "No notifications"
  exit 0
fi

SELECTION=$(cat "$LOGFILE" | tac | while IFS='|' read -r ts session window pane msg; do
  TARGET="${session}:${window}${pane:+.${pane}}"
  echo -e "${ts} | ${TARGET} | ${msg}"
done | fzf --height=80% --reverse --header="ESC: close | Enter: jump to session:window.pane")

if [[ -z "$SELECTION" ]]; then
  tmux display-message "Cancelled"
  exit 0
fi

TARGET=$(echo "$SELECTION" | cut -d'|' -f2 | tr -d ' ')

if [[ -z "$TARGET" ]]; then
  tmux display-message "Error: no target"
  exit 1
fi

tmux switch-client -t "$TARGET"
tmux display-message "Jumped to $TARGET"
