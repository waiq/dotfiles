#!/usr/bin/env sh

set -eu

msg_file="$1"
source_type="${2:-}"

case "$source_type" in
  merge|squash|commit)
    exit 0
    ;;
esac

branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
if [ -z "$branch" ]; then
  exit 0
fi

ticket_key="$(printf '%s\n' "$branch" | grep -oE '[A-Z][A-Z0-9]+-[0-9]+' | head -n 1 || true)"
if [ -z "$ticket_key" ]; then
  exit 0
fi

first_line="$(sed -n '1p' "$msg_file")"

if printf '%s' "$first_line" | grep -Eq '^(fixup!|squash!|revert )'; then
  exit 0
fi

if printf '%s' "$first_line" | grep -Eq '^([A-Z][A-Z0-9]+-[0-9]+)(:|\s|$)'; then
  exit 0
fi

tmp_file="$(mktemp)"
printf '%s: ' "$ticket_key" >"$tmp_file"

if [ -s "$msg_file" ]; then
  cat "$msg_file" >>"$tmp_file"
fi

mv "$tmp_file" "$msg_file"
